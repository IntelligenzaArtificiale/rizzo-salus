# API: tutto passa da index.php; sorgenti, librerie e script non sono mai raggiungibili dal web.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/?index\.php$
  RewriteRule ^(src|vendor|tests|bin|data)(/|$) - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>
<FilesMatch "^(?!index\.php$).+\.(php|json|lock|md|env|log|enc)$">
  Require all denied
</FilesMatch>
