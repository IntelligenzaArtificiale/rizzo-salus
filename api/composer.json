{
  "name": "poliambulatorio/gestionale-api",
  "description": "Backend del gestionale del poliambulatorio",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-sodium": "*",
    "ext-mbstring": "*",
    "ext-zip": "*",
    "ext-dom": "*",
    "ext-gd": "*",
    "dompdf/dompdf": "^3.0",
    "ext-calendar": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
